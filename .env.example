# Public origin of the site, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://atlasplast.iq

# Optional, server-only: a YouTube Data API v3 key so the Media page lists every
# video on the channel. Without it the page shows the channel's latest 15 uploads.
# YOUTUBE_API_KEY=

# Optional, build-time: ownership tags for Google Search Console and Bing Webmaster Tools
# (the "HTML tag" method; paste only the content value). DNS verification in Cloudflare
# needs neither.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional, runtime, production domain only: "true" sends every sitemap URL to IndexNow
# (Bing, Yandex and others) about 30 seconds after the server starts, i.e. on each deploy.
# INDEXNOW_SUBMIT=true
